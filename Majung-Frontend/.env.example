# 실제 키는 .env에 (git 추적 안 됨). 이 파일은 구조 공유용 템플릿.
# 주의: EXPO_PUBLIC_ 접두사 변수는 클라이언트 번들에 노출됨 — 노출 허용 키만 (Maps 웹 키는 도메인 제한 필수)
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_GOOGLE_MAPS_KEY=AIzaxxxx
# 음성 감정 적응형 RAG(SER) 서비스 — PC의 SER 서버(모델 무거워 자체호스팅).
# 폰 테스트 시 cloudflared 터널 HTTPS URL로 교체 (예: https://xxxx.trycloudflare.com)
EXPO_PUBLIC_SER_URL=http://localhost:8500
# (선택) 터널 접근용 '약한 게이트' 토큰. EXPO_PUBLIC_이라 번들 노출 → 진짜 비밀 아님. 데모 한정.
EXPO_PUBLIC_SER_TOKEN=
