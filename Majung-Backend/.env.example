# 실제 값은 .env에 (git 추적 안 됨). 이 파일은 구조 공유용 템플릿.

# ── Claude API ──
ANTHROPIC_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-sonnet-5
# Mock LLM 강제(무비용 데모 — 실 Claude 호출 0). 미설정이어도 키가 비면 자동 Mock.
# 실 응답으로 전환: ANTHROPIC_API_KEY 채우고 USE_MOCK_LLM=false
USE_MOCK_LLM=true

# ── 접근 게이트 (배포 전 필수) ──
# 데모 진입 코드의 sha256 해시(hex). 평문 코드는 저장하지 않는다.
# 생성 예: python -c "import hashlib;print(hashlib.sha256('마중데모2026'.encode()).hexdigest())"
# 비워두면 게이트 비활성(로컬 개발). 배포 전 반드시 설정.
DEMO_ACCESS_CODE_HASH=
# 게이트 토큰 서명용 시크릿 (배포 시 임의 문자열로 교체)
SESSION_SECRET=change-me-to-a-random-string
SESSION_TTL_SECONDS=21600

# ── 남용 방어 (선택, 기본값 있음) ──
RATE_LIMIT_CHAT=20/minute
SPEND_MAX_CALLS_PER_HOUR=300
SPEND_MAX_CALLS_PER_DAY=2000

# ── 웹 검색 (일상 질문용, 공공 도메인 한정) ──
# 비워두면 코드의 기본값(§6.4 확정 24개)을 쓴다. 지자체 2곳은 근거로만 쓰고 검색에서 뺀다.
# WEB_SEARCH_ALLOWED_DOMAINS=
WEB_SEARCH_MAX_USES=3

# ── CORS ──
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Supabase (사용자 데이터 저장 · 기획서 §9) ──
# service_role 키는 **서버에만** 둔다. 테이블에 RLS가 켜져 있고 정책이 없어서
# anon 키로는 아무것도 읽지 못한다 — 이 키가 클라이언트로 내려가면 그 방어가 무너진다.
# 대시보드 > Project Settings > API Keys > service_role 에서 복사한다.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# 컬럼 단위 암호화 키 (base64 32바이트).
# 생성: uv run python -c "from app.infrastructure.security import crypto; print(crypto.generate_key())"
# **키를 바꾸면 기존 데이터를 읽을 수 없다.** 그리고 없으면 저장 기능이 뜨지 않는다 —
# 평문으로 저장하는 폴백은 두지 않는다(§9.2).
FIELD_ENCRYPTION_KEY=

# CLI 검증 모드 (실 API 키를 붙이기 전 실제 모델 응답을 볼 때만).
# 배포에는 쓰지 않는다 — 구독 크레딧에 묶인다.
USE_CLI_LLM=false
