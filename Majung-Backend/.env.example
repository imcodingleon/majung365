# 실제 값은 .env에 (git 추적 안 됨). 이 파일은 구조 공유용 템플릿.

# ── Claude API ──
ANTHROPIC_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-sonnet-5
# Mock LLM 강제(무비용 데모 — 실 Claude 호출 0). 미설정이어도 키가 비면 자동 Mock.
# 실 응답으로 전환: ANTHROPIC_API_KEY 채우고 USE_MOCK_LLM=false
USE_MOCK_LLM=true

# ── 접근 게이트 (배포 전 필수) ──
# 데모 진입 코드의 sha256 해시(hex). 평문 코드는 저장하지 않는다.
# 생성 예: python -c "import hashlib;print(hashlib.sha256('마중데모2026'.encode()).hexdigest())"
# 비워두면 게이트 비활성(로컬 개발). 배포 전 반드시 설정.
DEMO_ACCESS_CODE_HASH=
# 게이트 토큰 서명용 시크릿 (배포 시 임의 문자열로 교체)
SESSION_SECRET=change-me-to-a-random-string
SESSION_TTL_SECONDS=21600

# ── 남용 방어 (선택, 기본값 있음) ──
RATE_LIMIT_CHAT=20/minute
SPEND_MAX_CALLS_PER_HOUR=300
SPEND_MAX_CALLS_PER_DAY=2000

# ── 웹 검색 (일상 질문용, 공공 도메인 한정) ──
WEB_SEARCH_ALLOWED_DOMAINS=gov.kr,korea.kr,bokjiro.go.kr,work24.go.kr,koreha.or.kr,mohw.go.kr,moel.go.kr
WEB_SEARCH_MAX_USES=3

# ── CORS ──
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
